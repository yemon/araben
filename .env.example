# Copy to .env and fill in values. (The Prisma CLI only reads .env, not
# .env.local; the app and the audio script read either.)

# ---------- Audio generation (scripts/generate-audio.mjs) ----------

# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice to use. Defaults to a well-known multilingual voice good for Arabic.
# Rachel (multilingual): 21m00Tcm4TlvDq8ikWAM
# Adam (multilingual):   pNInz6obpgDQGcFmaJgB
# You can swap to any voice that supports the eleven_multilingual_v2 model.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: model. eleven_multilingual_v2 handles Arabic well.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# How many words to generate on the first pass.
AUDIO_BATCH_SIZE=100

# ---------- Database ----------

# MySQL connection for the content, the trace game and the admin.
# See DATABASE_SETUP.md.
DATABASE_URL="mysql://root:@localhost:3306/araben"

# ---------- Admin sign-in (NextAuth) ----------

# The site's public address.
NEXTAUTH_URL="http://localhost:3000"

# Signs the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it private; changing it signs every admin out.
NEXTAUTH_SECRET=
